<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- China-accessible NuGet v3 mirror used by this build. Replace with
         https://api.nuget.org/v3/index.json if you prefer the primary feed. -->
    <add key="nuget-mirror" value="https://nuget.azure.cn/v3/index.json" />
  </packageSources>
</configuration>
